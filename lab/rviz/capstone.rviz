Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (0.5 m cells)
      Enabled: true
      Reference Frame: <Fixed Frame>
      Plane: XY
      Plane Cell Count: 8
      Cell Size: 0.5
      Color: 160; 160; 164
      Alpha: 0.5
    - Class: rviz_default_plugins/RobotModel
      Name: Robot (TurtleBot3 Burger)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF frames
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.4
    - Class: rviz_default_plugins/LaserScan
      Name: Laser scan from the simulator (/scan)
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 239; 171; 0
      Alpha: 1
      Decay Time: 0
    - Class: rviz_default_plugins/LaserScan
      Name: Scan the controller sees (/workshop/scan, after fault injection)
      Enabled: true
      Topic:
        Value: /workshop/scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.06
      Color Transformer: FlatColor
      Color: 44; 142; 205
      Alpha: 0.6
      Decay Time: 0
    - Class: rviz_default_plugins/Odometry
      Name: Odometry trail (/odom)
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 200
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 255; 255; 255
        Alpha: 1
        Shaft Length: 0.12
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.025
      Covariance:
        Value: false
  Enabled: true
  Global Options:
    Background Color: 27; 37; 51
    Fixed Frame: odom
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 4.2
      Focal Point:
        X: 1.0
        Y: 0
        Z: 0
      Pitch: 0.95
      Yaw: 3.5
      Near Clip Distance: 0.01
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 720
  Width: 1100
  X: 40
  Y: 40
